    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "motion": "^12.36.0",
    "pg": "^8.23.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.5.0",
